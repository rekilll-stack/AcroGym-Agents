        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Field normalization for AcroGym website lead form.\n// Token auth enforced by the Webhook node itself (Header Auth credential,\n// header x-webhook-token) — n8n rejects bad/missing tokens with 403 before\n// this node runs. ($env is blocked for Code nodes in n8n 2.x task runners.)\nconst body = $input.first().json.body || {};\n\n// --- normalizePhone: KEEP IN SYNC with acrogym/shared/normalize.js ---\nfunction normalizePhone(raw) {\n  if (!raw) return null;\n  let digits = String(raw).replace(/\\D/g, '');\n  if (!digits) return null;\n  digits = digits.replace(/^0+/, '');\n  if (!digits) return null;\n  if (digits.startsWith('974') && digits.length >= 11) return digits;\n  if (digits.length === 8) return '974' + digits;\n  return digits;\n}\n\nconst name = String(body.name || body.parent_name || '').trim().slice(0, 120);\nconst phone = normalizePhone(body.phone || body.parent_phone);\nconst childAge = String(body.child_age || body.age || '').trim().slice(0, 20);\nconst source = String(body.source || 'website_form').trim().slice(0, 60);\n\n// A real phone has at least 8 digits. A bare country code ('974') or junk\n// is rejected here so empty-phone leads never reach the sheet.\nif (!phone || phone.length < 8) {\n  return [{ json: { ok: false, httpCode: 400, error: 'a valid phone is required' } }];\n}\nif (!name) {\n  return [{ json: { ok: false, httpCode: 400, error: 'name is required' } }];\n}\n\nreturn [{ json: { ok: true, name, phone, child_age: childAge, source } }];"
        }
