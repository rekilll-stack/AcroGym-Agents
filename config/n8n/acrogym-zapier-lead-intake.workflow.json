      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// AcroGym Zapier (Meta Lead Ads bypass) intake — mirrors website intake.\n// Token auth enforced by the Webhook node (Header Auth, header x-webhook-token):\n// n8n rejects bad/missing tokens with 403 before this node runs.\n// normalizePhone KEPT IN SYNC with acrogym/shared/normalize.js (dedup depends on it).\nconst body = $input.first().json.body || {};\n\nfunction normalizePhone(raw) {\n  if (!raw) return null;\n  let digits = String(raw).replace(/\\D/g, '');\n  if (!digits) return null;\n  digits = digits.replace(/^0+/, '');\n  if (!digits) return null;\n  if (digits.startsWith('974') && digits.length >= 11) return digits;\n  if (digits.length === 8) return '974' + digits;\n  return digits;\n}\n\n// Accept several common field names so Zapier mapping is forgiving.\nconst name = String(body.name || body.full_name || body.parent_name || [body.first_name, body.last_name].filter(Boolean).join(' ') || '').trim().slice(0, 120);\nconst phone = normalizePhone(body.phone || body.phone_number || body.parent_phone);\nconst childAge = String(body.child_age || body.age || '').trim().slice(0, 20);\nconst source = String(body.source || 'meta_zapier').trim().slice(0, 60);\n\nif (!phone || phone.length < 8) {\n  return [{ json: { ok: false, httpCode: 400, error: 'a valid phone is required' } }];\n}\nif (!name) {\n  return [{ json: { ok: false, httpCode: 400, error: 'name is required' } }];\n}\nreturn [{ json: { ok: true, name, phone, child_age: childAge, source } }];"
      }
    },
